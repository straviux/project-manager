# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# Generated app icons (run `npm run tauri icon <logo.png>`)
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
!src-tauri/icons/.gitkeep

# Local database
*.db
*.db-journal

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# Files shown in VS Code Source Control (2026-10-28)
# Signing keys — the private key must never be committed. These live in
# %USERPROFILE%\.tauri\ on the signing machine; these patterns also
# protect them if a copy ever lands inside the repo.
*.key
project-manager.key
project-manager.pub
.tauri/
# Generated lockfiles, local to each machine's build
src-tauri/Cargo.lock
Cargo.lock
Cargo.toml
package-lock.json
# Project manifest shown as modified in the same view. Note: Cargo.toml
# is already tracked, so this pattern alone does not untrack it — see
# the note in the chat message before removing it from tracking.
Cargo.toml
src-tauri/Cargo.toml
.gitignore
